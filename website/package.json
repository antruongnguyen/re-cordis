{
  "name": "re-cordis-documentation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "build": "bun scripts/prepare.ts && next build --webpack && bun scripts/finalize.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "bun test scripts",
    "check": "bun test scripts && bun scripts/check.ts",
    "preview": "bun scripts/preview.ts"
  },
  "dependencies": {
    "fumadocs-core": "16.17.10",
    "fumadocs-ui": "16.17.10",
    "hast-util-to-text": "4.0.3",
    "mdast-util-to-string": "4.0.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "remark-stringify": "11.0.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/bun": "1.4.4",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cheerio": "1.2.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3"
  }
}
